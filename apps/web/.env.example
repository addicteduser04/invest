# App
# Explicit application environment: one of local, staging, production, test. Only needed by the
# admin market-data tools below (see MARKET_INGESTION_PROVIDER) -- leave unset for local
# development.
APP_ENV=
# Public URL used for redirects (for example http://127.0.0.1:3000).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase
# Public Supabase project URL. Use the local value printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe Supabase publishable/anonymous key, from `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin market-data tools
# Set to "true" only in local development or on the staging deployment (APP_ENV=staging) to
# enable the BVC public-testing connector used by the admin market-data tools. Never set in
# production.
BVC_PUBLIC_TESTING_ENABLED=
# Direct PostgreSQL connection string, used server-side for admin rate limiting and the annual
# reports sync. Market ingestion no longer runs inside the web app. Local Supabase development:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=
# Daily market ingestion provider for the admin-triggered run/retry routes. One of:
# bvc_public_testing (only permitted when APP_ENV=staging AND BVC_PUBLIC_TESTING_ENABLED=true,
# or in local development -- APP_ENV=production always refuses it), licensed_api, licensed_sftp.
MARKET_INGESTION_PROVIDER=

# Market ingestion runner (.github/workflows/market-ingestion.yml). The admin "Run market import"
# and "Retry failed instruments" actions dispatch that workflow; when these are unset the actions
# are hidden and the routes answer 503 EXECUTOR_NOT_CONFIGURED rather than create runs that
# nothing executes.
# Fine-grained GitHub token restricted to this repository with "Actions: read and write" only.
MARKET_INGESTION_DISPATCH_TOKEN=
# owner/repository hosting the workflow, e.g. addicteduser04/invest.
MARKET_INGESTION_DISPATCH_REPOSITORY=
# GitHub environment the job runs in (holds this deployment's WORKER_DATABASE_URL secret and
# APP_ENV / MARKET_INGESTION_PROVIDER / BVC_PUBLIC_TESTING_ENABLED variables), e.g. staging.
MARKET_INGESTION_DISPATCH_ENVIRONMENT=
# Git ref to run the workflow from (default main).
MARKET_INGESTION_DISPATCH_REF=
