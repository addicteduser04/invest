# Public URL used for redirects (for example http://127.0.0.1:3000).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Public Supabase project URL. Use the local value printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe Supabase publishable/anonymous key, from `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to "true" only in local/private environments to enable the BVC public-testing
# connector used by the admin market-data tools. Never set in production.
BVC_PUBLIC_TESTING_ENABLED=
# Direct PostgreSQL connection string, used only by the admin market-data "Run import" /
# "Retry failed instruments" API routes (which invoke the same @bvc/market-ingestion
# pipeline as `pnpm market:daily`). Local Supabase development:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=
# Daily market ingestion provider for the admin-triggered run/retry routes. One of:
# bvc_public_testing (local/private testing only), licensed_api, licensed_sftp.
MARKET_INGESTION_PROVIDER=
