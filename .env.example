# App
# Explicit application environment: one of local, staging, production, test. Distinguishes
# staging from real production for safety gates that NODE_ENV/hosting-platform metadata cannot
# (Vercel sets NODE_ENV=production for the staging deployment too) -- see MARKET_INGESTION_PROVIDER
# below. Leave unset for local development; a missing/invalid value is treated as local unless
# the build is deployed (NODE_ENV=production), in which case it is treated as production.
APP_ENV=
# Public URL used for redirects (for example http://localhost:3000).
NEXT_PUBLIC_APP_URL=

# Supabase
# Public Supabase project URL. Synthetic/local project only during development.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe Supabase publishable/anonymous key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service credential; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL
# Pooled application PostgreSQL connection string.
DATABASE_URL=
# Direct PostgreSQL connection string used only by the worker.
# Local Supabase development: postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=

# Market data
# Provider adapter identifier; use "synthetic" or "admin_csv" locally.
MARKET_DATA_PROVIDER=synthetic
# Optional future licensed provider endpoint.
MARKET_DATA_API_URL=
# Optional future licensed provider secret.
MARKET_DATA_API_KEY=
# Daily market ingestion provider (pnpm market:daily; also used by the admin market-data
# run/retry API routes). One of: bvc_public_testing (only permitted when APP_ENV=staging AND
# BVC_PUBLIC_TESTING_ENABLED=true, or in local development — APP_ENV=production always refuses
# it, with no override), licensed_api, licensed_sftp.
MARKET_INGESTION_PROVIDER=
# Set to "true" only in local development or on the staging deployment (APP_ENV=staging) to
# enable the BVC public-testing connector. Never set in production.
BVC_PUBLIC_TESTING_ENABLED=

# Internal worker authentication
# Secret used to authenticate internal worker messages.
# Use a development-only 32+ character value in ignored local env files.
INTERNAL_JOB_SIGNING_SECRET=

# Optional integrations
# Optional server-side error tracking endpoint.
ERROR_TRACKING_DSN=
# Optional transactional email provider credential.
EMAIL_PROVIDER_API_KEY=
