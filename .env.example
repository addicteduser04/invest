# Public URL used for redirects (for example http://localhost:3000).
NEXT_PUBLIC_APP_URL=
# Public Supabase project URL. Synthetic/local project only during development.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe Supabase publishable/anonymous key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service credential; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled application PostgreSQL connection string.
DATABASE_URL=
# Direct PostgreSQL connection string used only by the worker.
WORKER_DATABASE_URL=
# Provider adapter identifier; use "synthetic" or "admin_csv" locally.
MARKET_DATA_PROVIDER=synthetic
# Optional future licensed provider endpoint.
MARKET_DATA_API_URL=
# Optional future licensed provider secret.
MARKET_DATA_API_KEY=
# Secret used to authenticate internal worker messages.
INTERNAL_JOB_SIGNING_SECRET=
# Optional server-side error tracking endpoint.
ERROR_TRACKING_DSN=
# Optional transactional email provider credential.
EMAIL_PROVIDER_API_KEY=
